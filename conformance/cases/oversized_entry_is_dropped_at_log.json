{
  "name": "oversized_entry_is_dropped_at_log",
  "config": {
    "batch_size": 1000,
    "flush_interval_ms": 60000
  },
  "steps": [
    {
      "log": {
        "event": "too_big",
        "metadata": {
          "blob": ""
        }
      }
    },
    {
      "log": {
        "event": "fine"
      }
    },
    {
      "flush": {}
    }
  ],
  "expect": {
    "requests": [
      {
        "entries": [
          {
            "event": "fine"
          }
        ]
      }
    ],
    "dropped": 1
  },
  "why": "An entry the server will refuse must never join a batch. One 5 KB event costing the 499 good ones beside it is the failure this prevents, and the caller learns about it at the call site."
}
