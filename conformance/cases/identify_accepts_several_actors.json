{
  "name": "identify_accepts_several_actors",
  "config": {
    "batch_size": 1000,
    "flush_interval_ms": 60000
  },
  "steps": [
    {
      "identify": {
        "user_id": "user_123",
        "organization_id": "org_42",
        "device_id": "camera_7",
        "session_id": "sess_8f21"
      }
    },
    {
      "log": {
