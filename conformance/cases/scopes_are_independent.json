{
  "name": "scopes_are_independent",
  "config": {
    "batch_size": 1000,
    "flush_interval_ms": 60000
  },
  "steps": [
    {
      "identify": {
        "user_id": "user_a"
      },
      "as": "a"
    },
    {
      "identify": {
        "user_id": "user_b"
      },
      "as": "b"
    },
    {
      "log": {
        "event": "first"
      },
      "via": "a"
    },
    {
      "log": {
        "event": "second"
      },
      "via": "b"
    },
    {
      "log": {
        "event": "third"
      },
      "via": "a"
    },
    {
      "flush": {}
    }
  ],
  "expect": {
    "requests": [
      {
        "entries": [
          {
            "event": "first",
            "actor": {
              "user_id": "user_a"
            }
          },
          {
            "event": "second",
            "actor": {
              "user_id": "user_b"
            }
          },
          {
            "event": "third",
            "actor": {
              "user_id": "user_a"
            }
          }
        ]
      }
    ]
  },
  "why": "A server handles many people at once from one client. If identity were client state rather than scope state, these would overwrite each other and events would be attributed to the wrong person."
}
